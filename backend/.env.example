# MongoDB Connection String
# Defaults to your local MongoDB service. Edit this to switch to a hosted instances (e.g. MongoDB Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/forma-ai

# Backend server execution port
PORT=5000

# Google Gemini API Key
# To obtain a Gemini API key:
# 1. Visit Google AI Studio (https://aistudio.google.com/)
# 2. Sign in with your Google account.
# 3. Click "Get API Key" and generate a new key.
# 4. Copy the generated key and paste it below.
GEMINI_API_KEY=your_gemini_api_key_here
